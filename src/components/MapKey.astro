---
import { PLACES } from '../lib/places';
---

<aside class="key">
	{PLACES.map((place) => (
		<details data-for={place.slug}>
			<summary>
				<span class="label">Terrain</span>
				<span class="name">{place.name}</span>
			</summary>
			<p>{place.note}</p>
			<p class="source">
				{place.region} · elevation data from SRTM, contours traced at build time.
			</p>
		</details>
	))}
</aside>

<style>
	.key {
		position: fixed;
		right: var(--space-md);
		bottom: var(--space-md);
		z-index: 2;
		max-width: 20rem;
		font-family: var(--font-mono);
	}

	/* Every place renders; CSS shows the one the root attribute selects. That
	   way the key needs no JavaScript of its own. */
	details {
		display: none;
		background: var(--paper-raised);
		border: 1px solid var(--rule);
		border-radius: 3px;
		padding: var(--space-xs) var(--space-sm);
	}

		/* Shown by the inline style below, which compares each entry's slug against
	   the root attribute. One rule for any number of places. */

	summary {
		cursor: pointer;
		list-style: none;
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		color: var(--ink-muted);
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.label {
		text-transform: uppercase;
		opacity: 0.7;
	}

	.name {
		color: var(--ink);
	}

	.name::before {
		content: ' · ';
		color: var(--ink-muted);
	}

	details[open] summary {
		margin-bottom: var(--space-xs);
	}

	p {
		margin: 0 0 var(--space-xs);
		font-size: 0.7rem;
		line-height: 1.5;
		color: var(--ink-muted);
	}

	.source {
		margin-bottom: 0;
		opacity: 0.75;
	}

	@media (max-width: 40rem) {
		.key {
			display: none;
		}
	}
</style>
