---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import MapKey from '../components/MapKey.astro';
import '../styles/contours.css';
import { PLACES } from '../lib/places';

interface Props {
	title: string;
}
const {title} = Astro.props;
---
<html lang="en" data-field="yosemite">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Newsreader:opsz,wght@6..72,400;6..72,600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Picks which terrain is drawn behind the page. Inline and in <head> so
		     it runs before first paint; the attribute above is a working default,
		     so a failure here changes nothing. -->
		<script is:inline define:vars={{ fields: PLACES.map((place) => place.slug) }}>
			try {
				document.documentElement.dataset.field =
					fields[Math.floor(Math.random() * fields.length)];
			} catch {}
		</script>
	</head>
	<body>
		<SiteHeader />
		<slot />
		<MapKey />
	</body>
</html>