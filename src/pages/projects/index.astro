---
import { getCollection } from 'astro:content';
import { sortProjects, countShipped } from '../../lib/projects';
import BadgeGrid from '../../components/BadgeGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = await getCollection('projects');
const ordered = sortProjects(projects);
const shipped = countShipped(projects);
---

<BaseLayout title="Projects">
	<div class="wide">
		<h1>Projects</h1>
		<p class="count">{shipped} of {ordered.length} shipped</p>

		<BadgeGrid projects={ordered} />
	</div>
</BaseLayout>

<style>
	h1 {
		margin-bottom: var(--space-xs);
	}

	.count {
		margin: 0 0 var(--space-lg);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
</style>
